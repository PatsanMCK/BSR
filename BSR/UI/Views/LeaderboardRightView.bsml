<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <vertical spacing='1.5' pad='3' align='Center'>
        <text text='LEADERBOARD' font-size='5.2' align='Center' color='#FFFFFF'/>

        <!-- TOP 1 TO 5 PANEL -->
        <vertical bg='round-rect-panel' pad='3' pref-width='72' spacing='1.2'>
            <horizontal pref-width='66'>
                <text text='~row1-left' font-size='3.6' align='Left'/>
                <text text='~row1-right' font-size='3.6' overflow-mode='Ellipsis' align='Right'/>
            </horizontal>
            <horizontal pref-width='66'>
                <text text='~row2-left' font-size='3.6' align='Left'/>
                <text text='~row2-right' font-size='3.6' overflow-mode='Ellipsis' align='Right'/>
            </horizontal>
            <horizontal pref-width='66'>
                <text text='~row3-left' font-size='3.6' align='Left'/>
                <text text='~row3-right' font-size='3.6' overflow-mode='Ellipsis' align='Right'/>
            </horizontal>
            <horizontal pref-width='66'>
                <text text='~row4-left' font-size='3.6' align='Left'/>
                <text text='~row4-right' font-size='3.6' overflow-mode='Ellipsis' align='Right'/>
            </horizontal>
            <horizontal pref-width='66'>
                <text text='~row5-left' font-size='3.6' align='Left'/>
                <text text='~row5-right' font-size='3.6' overflow-mode='Ellipsis' align='Right'/>
            </horizontal>
            <horizontal pref-width='66'>
                <text text='~me-left' font-size='3.6' color='#00FFCC' align='Left'/>
                <text text='~me-right' font-size='3.6' color='#FFFFFF' overflow-mode='Ellipsis' align='Right'/>
            </horizontal>
        </vertical>
        <button text='Refresh' on-click='on-refresh-click' pref-width='26' pref-height='7'/>
    </vertical>
</bg>