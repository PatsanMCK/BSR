<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <vertical spacing='1.8' pad='3' align='Center'>
        <text text='OPPONENT' font-size='5.2' align='Center' color='#FF5555'/>

        <!-- OPPONENT PFP, NAME BELOW IT, AND AVG STARS (Matches ProfileLeftView layout) -->
        <vertical bg='round-rect-panel' pad='3' pref-width='52' align='Center' spacing='1.2'>
            <image id='opponent-pfp-img' pref-width='18' pref-height='18' preserve-aspect='true'/>
            <text id='opponent-name-txt' text='~opponent-name' font-size='4.4' align='Center'/>
            <text text='~opponent-avg-stars' font-size='2.8' color='#888888' align='Center'/>
        </vertical>

        <!-- RANK & ELO -->
        <horizontal bg='round-rect-panel' pad='2' pref-width='52' spacing='8' align='Center'>
            <vertical align='Center'>
                <text text='RANK' font-size='3' color='#AAAAAA' align='Center'/>
                <text text='~opponent-tier' font-size='5' align='Center'/>
            </vertical>
            <vertical align='Center'>
                <text text='ELO' font-size='3' color='#AAAAAA' align='Center'/>
                <text text='~opponent-elo' font-size='4.8' color='#FFFFFF' align='Center'/>
            </vertical>
        </horizontal>

        <text text='~opponent-hp-text' font-size='4' color='#00FF66' align='Center'/>

        <!-- FORFEIT BUTTON BELOW OPPONENT -->
        <button text='~forfeit-btn-text' interactable='~can-forfeit' on-click='on-forfeit-click' pref-width='36' pref-height='8'/>
    </vertical>
</bg>